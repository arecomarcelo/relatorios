# ========================================
# CONFIGURAÇÕES DE BANCO DE DADOS - Relatórios
# ========================================
# Local/legado (Streamlit Cloud): IP público da VPS.
# Deploy Docker na VPS (stack.yml): use "host-postgres" — resolvido via
# extra_hosts (host-gateway) para o Postgres nativo do host, sem sair
# para a internet pública.
DB_HOST=195.200.1.244
DB_PORT=5432
DB_NAME=sga
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# ========================================
# IDENTIDADE CENTRAL (administracao/oficial_db)
# ========================================
# Conexão DEDICADA, separada da conexão de dados de negócio acima — usada só
# por apps/auth/central_auth_service.py para autenticar contra
# administracao.auth_user e checar AcessoApp/ModuloMenu/AcessoModuloMenu.
# Local (dev, container sga_db_local): host=localhost, port=5440.
# Produção (rede overlay oficial_db_net): host=oficial_container, port=5432.
# Credencial: role relatorios_user, provisionado via ProvisionamentoService
# no app administracao (só GRANT SELECT nas 5 tabelas centrais).
OFICIAL_DB_HOST=localhost
OFICIAL_DB_PORT=5440
OFICIAL_DB_NAME=oficial_db
OFICIAL_DB_USER=relatorios_user
OFICIAL_DB_PASSWORD=sua_senha_aqui

# ========================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ========================================
DEBUG=False
APP_TITLE=Relatórios - Oficial Sport
CACHE_TTL=300
LOG_LEVEL=INFO

# ========================================
# CONFIGURAÇÕES DE CACHE
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ========================================
# CONFIGURAÇÕES DE SEGURANÇA
# ========================================
SECRET_KEY=sua_chave_secreta_aqui
SESSION_TIMEOUT=3600

# ========================================
# DASHBOARD DE CAMPANHAS (opcional)
# ========================================
# O arquivo de origem (documentacao/Relatorio Adwords.xlsx) é versionado no
# próprio repositório — o código já resolve esse caminho sozinho, tanto local
# quanto no container (acompanha o build/deploy normal). Só defina esta
# variável se quiser apontar para um arquivo em outro local.
# CAMPANHAS_XLSX_PATH=/caminho/para/outro/arquivo.xlsx

# ========================================
# DASHBOARD DE CAMPANHA META (opcional)
# ========================================
# O arquivo de origem (documentacao/Relatório Meta.xlsx) é versionado no
# próprio repositório — o código já resolve esse caminho sozinho, tanto local
# quanto no container (acompanha o build/deploy normal). Só defina esta
# variável se quiser apontar para um arquivo em outro local.
# CAMPANHA_META_XLSX_PATH=/caminho/para/outro/arquivo.xlsx